generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id          String   @id @default(uuid())
  firebaseUid String   @unique @map("firebase_uid")
  email       String   @unique
  nickname    String?  @unique
  fullName    String   @map("full_name")
  avatarUrl   String?  @map("avatar_url")
  bio         String?
  role        Role     @default(USER)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  recipes         Recipe[]
  allergies       UserAllergy[]
  fridgeItems     UserFridgeItem[]
  favoriteRecipes FavoriteRecipe[]
  reviews         Review[]
  cooksnaps       Cooksnap[]

  @@map("users")
}

model Category {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  slug    String   @unique
  iconUrl String?  @map("icon_url")
  recipes Recipe[]

  @@map("categories")
}

model DietaryRegime {
  id      Int                @id @default(autoincrement())
  name    String             @unique
  slug    String             @unique
  recipes RecipeDietaryTag[]

  @@map("dietary_regimes")
}

model Ingredient {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  standardUnit String @map("standard_unit") // gram, ml, quả, muỗng...
  imageUrl    String? @map("image_url")

  recipeIngredients RecipeIngredient[]
  userAllergies     UserAllergy[]
  fridgeItems       UserFridgeItem[]

  @@map("ingredients")
}

model UserAllergy {
  userId       String     @map("user_id")
  ingredientId Int        @map("ingredient_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([userId, ingredientId])
  @@map("user_allergies")
}

model UserFridgeItem {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  ingredientId Int        @map("ingredient_id")
  quantity     Float      // Khối lượng hiện có theo đơn vị chuẩn của Ingredient
  expiryDate   DateTime?  @map("expiry_date")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientId])
  @@map("user_fridge_items")
}

model Recipe {
  id            String   @id @default(uuid())
  authorId      String   @map("author_id")
  categoryId    Int      @map("category_id")
  title         String
  description   String?
  thumbnailUrl  String   @map("thumbnail_url")
  servings      Int      @default(2)
  cookingTime   Int      @map("cooking_time") // Tính bằng phút
  averageRating Float    @default(0) @map("average_rating")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category    Category           @relation(fields: [categoryId], references: [id])
  steps       RecipeStep[]
  ingredients RecipeIngredient[]
  dietaryTags RecipeDietaryTag[]
  favoritedBy FavoriteRecipe[]
  reviews     Review[]
  cooksnaps   Cooksnap[]

  @@map("recipes")
}

model RecipeStep {
  id           String  @id @default(uuid())
  recipeId     String  @map("recipe_id")
  stepNumber   Int     @map("step_number")
  instruction  String
  imageUrl     String? @map("image_url")
  timerSeconds Int?    @map("timer_seconds")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, stepNumber])
  @@map("recipe_steps")
}

model RecipeIngredient {
  id           String  @id @default(uuid())
  recipeId     String  @map("recipe_id")
  ingredientId Int     @map("ingredient_id")
  quantity     Float
  note         String? // VD: "Thái lát mỏng", "Băm nhuyễn"

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model RecipeDietaryTag {
  recipeId        String        @map("recipe_id")
  dietaryRegimeId Int           @map("dietary_regime_id")
  recipe          Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  dietaryRegime   DietaryRegime @relation(fields: [dietaryRegimeId], references: [id], onDelete: Cascade)

  @@id([recipeId, dietaryRegimeId])
  @@map("recipe_dietary_tags")
}

model FavoriteRecipe {
  userId    String   @map("user_id")
  recipeId  String   @map("recipe_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
  @@map("favorite_recipes")
}

model Review {
  id        String   @id @default(uuid())
  recipeId  String   @map("recipe_id")
  userId    String   @map("user_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Cooksnap {
  id        String   @id @default(uuid())
  recipeId  String   @map("recipe_id")
  userId    String   @map("user_id")
  imageUrl  String   @map("image_url")
  caption   String?
  createdAt DateTime @default(now()) @map("created_at")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cooksnaps")
}