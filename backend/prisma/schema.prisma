generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum RecipeStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  HIDDEN
}

enum NotificationType {
  NEW_FOLLOWER
  NEW_REVIEW
  NEW_COOKSNAP
  SYSTEM
}

model User {
  id          String   @id @default(uuid())
  firebaseUid String   @unique @map("firebase_uid")
  email       String   @unique
  nickname    String?  @unique
  fullName    String   @map("full_name")
  avatarUrl   String?  @map("avatar_url")
  bio         String?
  role        Role     @default(USER)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  recipes               Recipe[]
  allergies             UserAllergy[]
  fridgeItems           UserFridgeItem[]
  favoriteRecipes       FavoriteRecipe[]
  reviews               Review[]
  cooksnaps             Cooksnap[]
  savedFilters          SavedFilter[]
  shoppingListItems     ShoppingListItem[]
  followers             Follow[]           @relation("UserFollowers")
  following             Follow[]           @relation("UserFollowing")
  deviceTokens          DeviceToken[]
  receivedNotifications Notification[]     @relation("NotificationRecipient")
  sentNotifications     Notification[]     @relation("NotificationActor")

  @@map("users")
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  slug         String        @unique
  iconUrl      String?       @map("icon_url")
  recipes      Recipe[]
  savedFilters SavedFilter[]

  @@map("categories")
}

model DietaryRegime {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  slug        String             @unique
  description String?
  recipes     RecipeDietaryTag[]

  @@map("dietary_regimes")
}

model Ingredient {
  id               Int     @id @default(autoincrement())
  name             String  @unique
  standardUnit     String  @map("standard_unit")
  imageUrl         String? @map("image_url")
  isAllergenCommon Boolean @default(false) @map("is_allergen_common")

  recipeIngredients RecipeIngredient[]
  userAllergies     UserAllergy[]
  fridgeItems       UserFridgeItem[]
  shoppingListItems ShoppingListItem[]

  @@map("ingredients")
}

model UserAllergy {
  userId       String     @map("user_id")
  ingredientId Int        @map("ingredient_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([userId, ingredientId])
  @@map("user_allergies")
}

model UserFridgeItem {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  ingredientId Int       @map("ingredient_id")
  quantity     Float
  expiryDate   DateTime? @map("expiry_date")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientId])
  @@map("user_fridge_items")
}

model Recipe {
  id            String   @id @default(uuid())
  authorId      String   @map("author_id")
  categoryId    Int      @map("category_id")
  title         String
  description   String?
  thumbnailUrl  String   @map("thumbnail_url")
  servings      Int      @default(2)
  cookingTime   Int      @map("cooking_time")
  averageRating Float    @default(0) @map("average_rating")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  author            User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category          Category           @relation(fields: [categoryId], references: [id])
  steps             RecipeStep[]
  ingredients       RecipeIngredient[]
  dietaryTags       RecipeDietaryTag[]
  favoritedBy       FavoriteRecipe[]
  reviews           Review[]
  cooksnaps         Cooksnap[]
  shoppingListItems ShoppingListItem[]

  @@map("recipes")
}

model RecipeStep {
  id           String  @id @default(uuid())
  recipeId     String  @map("recipe_id")
  stepNumber   Int     @map("step_number")
  instruction  String
  imageUrl     String? @map("image_url")
  timerSeconds Int?    @map("timer_seconds")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, stepNumber])
  @@map("recipe_steps")
}

model RecipeIngredient {
  id           String  @id @default(uuid())
  recipeId     String  @map("recipe_id")
  ingredientId Int     @map("ingredient_id")
  quantity     Float
  note         String?

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model RecipeDietaryTag {
  recipeId        String        @map("recipe_id")
  dietaryRegimeId Int           @map("dietary_regime_id")
  recipe          Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  dietaryRegime   DietaryRegime @relation(fields: [dietaryRegimeId], references: [id], onDelete: Cascade)

  @@id([recipeId, dietaryRegimeId])
  @@map("recipe_dietary_tags")
}

model FavoriteRecipe {
  userId    String   @map("user_id")
  recipeId  String   @map("recipe_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
  @@map("favorite_recipes")
}

model Review {
  id        String   @id @default(uuid())
  recipeId  String   @map("recipe_id")
  userId    String   @map("user_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipeId, userId])
  @@map("reviews")
}

model Cooksnap {
  id        String   @id @default(uuid())
  recipeId  String   @map("recipe_id")
  userId    String   @map("user_id")
  imageUrl  String   @map("image_url")
  caption   String?
  createdAt DateTime @default(now()) @map("created_at")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cooksnaps")
}

// ================= NEW MODELS =================

model SavedFilter {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  name             String
  categoryId       Int?     @map("category_id")
  dietaryRegimeIds Int[]    @default([]) @map("dietary_regime_ids")
  maxCookingTime   Int?     @map("max_cooking_time")
  minRating        Float?   @map("min_rating")
  excludeAllergies Boolean  @default(false) @map("exclude_allergies")
  sortBy           String?  @map("sort_by") // newest | rating | cooking_time
  isDefault        Boolean  @default(false) @map("is_default")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, isDefault])
  @@map("saved_filters")
}

model ShoppingListItem {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  ingredientId   Int?     @map("ingredient_id")
  customName     String?  @map("custom_name")
  quantity       Float    @default(1)
  unit           String?
  isChecked      Boolean  @default(false) @map("is_checked")
  sourceRecipeId String?  @map("source_recipe_id")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  sourceRecipe Recipe?     @relation(fields: [sourceRecipeId], references: [id], onDelete: SetNull)

  @@index([userId, isChecked])
  @@map("shopping_list_items")
}

model Follow {
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("follows")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String   @default("android") // android | ios | web
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String           @map("recipient_id")
  actorId     String?          @map("actor_id")
  type        NotificationType
  title       String
  body        String
  data        Json?
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead, createdAt])
  @@map("notifications")
}